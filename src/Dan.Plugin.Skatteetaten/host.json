{
	"version": "2.0",
	"extensions": {
		"http": {
			"dynamicThrottlesEnabled": false
		}
	},
	"telemetryMode": "OpenTelemetry",
	"logging": {
		"logLevel": {
			"default": "Information",
			"Microsoft": "Warning",
			"System.Net.Http.HttpClient": "Warning"
		},
		"OpenTelemetry": {
			"logLevel": {
				"default": "Information",
				"Microsoft": "Warning",
				"System.Net.Http.HttpClient": "Warning"
			}
		}
	}
}
